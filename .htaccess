Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|composer\.(json|lock)|phpunit\.xml(\.dist)?|bootstrap\.php)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(README(\.md)?|LICENSE(\.md)?|CHANGELOG(\.md)?|CONTRIBUTING(\.md)?|SECURITY(\.md)?|Makefile|docker-compose\.ya?ml)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(sql|log|bak|old|orig|dist)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectorySlash On

    # Wedos: veřejné URL nesmí obsahovat /domains/privofit.cz/ ani lokální /privofit/
    RewriteCond %{THE_REQUEST} \s/+domains/privofit\.cz(?:/([^?\s]*))? [NC]
    RewriteRule ^ /%1 [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^(www\.)?privofit\.cz$ [NC]
    RewriteCond %{THE_REQUEST} \s/+privofit[/?\s] [NC]
    RewriteRule ^privofit(?:/(.*))?$ /$1 [R=301,L,NE]

    RewriteRule ^$ index.php [L]
    RewriteRule ^adminer/?$ adminer.php [L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # GET /api/v1/reservations by jinak trefil soubor api/v1/reservations.php (MultiViews)
    # a vrátil prázdnou odpověď místo JSON pole rezervací.
    RewriteRule ^api(/|$) index.php [L]

    # Staré odkazy /public/... přesměruj na kořen projektu
    RewriteCond %{REQUEST_URI} ^(.*?)/public(/.*)?$
    RewriteRule ^public(/.*)?$ %1%2 [R=301,L]

    RewriteRule ^(\.git|\.svn|\.hg|\.idea|\.vscode)(/|$) - [F,L]
    RewriteRule ^(bin|config|database|docs|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^app/(Core|Controllers|Database|Middleware|Services|Support)(/|$) - [F,L]
    RewriteRule ^app/.*\.(php|phtml|phar)$ - [F,L]

    # Staré URL /app i /app/... jdou do front controlleru; PHP je přesměruje na /user
    RewriteRule ^app(/.*)?$ index.php [L]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{ENV:APP_FORCE_HTTPS} =1
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_mime.c>
    AddType image/vnd.microsoft.icon .ico
</IfModule>

<IfModule mod_headers.c>
    <Files "cron.php">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set CDN-Cache-Control "no-store"
    </Files>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>
