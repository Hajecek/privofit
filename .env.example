# =============================================================================
# PRIVOFIT – konfigurace prostředí
# Zkopírujte tento soubor jako .env a vyplňte skutečné hodnoty.
# Soubor .env nesmí být veřejně přístupný.
# =============================================================================

APP_NAME=PRIVOFIT
APP_ENV=local
APP_DEBUG=true
APP_URL=/privofit
APP_KEY=
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Prague
APP_LOCALE=cs-CZ
APP_CURRENCY=CZK

# Produkce na Wedos: APP_ENV=production, APP_DEBUG=false, APP_URL=https://privofit.cz
# APP_KEY vygenerujte: php bin/install.php --generate-key
# Hotový soubor je .env.production — na server ho nahrajte jako .env.

# Document root je kořen projektu (index.php). Citlivé složky jsou zakázané v .htaccess.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=privofit
DB_USERNAME=root
DB_PASSWORD=
# Wedos: DB_HOST=md437.wedos.net  DB_DATABASE=d404218_pf  DB_USERNAME=a404218_pf
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=privofit_session
SESSION_LIFETIME=20160
SESSION_IDLE_MINUTES=20
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
REMEMBER_ME_DAYS=30
MFA_TRUST_DAYS=30

MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@privofit.cz
MAIL_FROM_NAME="PRIVOFIT"

# Have I Been Pwned k-anonymity (odesílá se pouze prefix SHA-1, nikoli heslo)
HIBP_ENABLED=true

# Firebase účet služby pro push (FCM HTTP v1). JSON nepatří do gitu.
FIREBASE_CREDENTIALS=storage/firebase/privofit-firebase-adminsdk.json

# Vstupní systém. mock = testovací režim, nuki = ostrá integrace po ověření zařízení.
DOOR_PROVIDER=mock
NUKI_API_BASE=https://api.nuki.io
NUKI_API_TOKEN=
NUKI_SMARTLOCK_ID=
NUKI_ACTION=unlatch
NUKI_TIMEOUT=15

# Sběratelská karta do Apple Wallet. Certifikát Pass Type ID zůstává jen na serveru.
WALLET_PASS_TYPE_ID=pass.cz.privofit.cz
WALLET_TEAM_ID=W6R3HZD7R4
WALLET_PASS_CERT=storage/wallet/pass.pem
WALLET_PASS_KEY=storage/wallet/pass.key
WALLET_PASS_WWDR=storage/wallet/wwdr.pem

# Platební brána. Tajný klíč patří jen na server, nikdy do iOS aplikace.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Evropské karty, včetně českého Apple Pay: 1,5 % + 6,50 Kč.
# Britské a ostatní zahraniční karty se dopočítají při platbě podle země karty.
STRIPE_FEE_PERCENT=1.5
STRIPE_FEE_FIXED_CZK=6.50

# Cron token pro volání bin/cron.php přes HTTPS (Wedos plánovač)
CRON_TOKEN=

# Google přihlášení. Client secret patří jen do .env, nikdy do gitu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS klient z Google Cloud (typ iOS). Jiný client ID než web. Redirect musí sedět s aplikací.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REDIRECT_URI=

# Apple přihlášení. Soubor .p8 patří jen na server, nikdy do gitu.
# APPLE_CLIENT_ID je Services ID webu. Aplikace používá bundle ID jako audience tokenu.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=storage/apple/AuthKey.p8
APPLE_BUNDLE_ID=cz.privofit.app

# Instalace: po vytvoření OWNER účtu se instalační endpoint deaktivuje.
INSTALL_ENABLED=true
